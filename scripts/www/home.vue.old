        <view class="chat-text">闇瑕佸仴韬建记悧锛熺偣鍑讳笌AI绉佹暀瀵硅瘽锛</view>
        <view class="chat-arrow"></view>
      </view>
    </view>
  </view>
</template>

<script>
export default {
  data() {
    return {
      greeting: '早上好',
      completedToday: 0
    };
  },
  mounted() {
    this.setGreeting();
    this.loadUserStats();
  },
  methods: {
    setGreeting() {
      const hour = new Date().getHours();
      if (hour < 6) this.greeting = '凌晨好';
      else if (hour < 12) this.greeting = '早上好';
      else if (hour < 14) this.greeting = '中午好';
      else if (hour < 18) this.greeting = '下午好';
      else if (hour < 22) this.greeting = '晚上好';
      else this.greeting = '夜深了';
    },
    loadUserStats() {
      // 妯℃嫙动犺浇生埛数数据
      setTimeout(() => {
        // 瀹為檯度旂敤中繖閲屼細今嶢PI鑾峰彇数数据
        this.completedToday = 0;
      }, 500);
    },
    goToCalendar() {
      console.log('跳转到日历页面');
      this.navigateTo('/frontend/calendar');
    },
    startTraining() {
      console.log('开始训练');
      this.navigateTo('/frontend/ai-assistant');
    },
    viewPlanDetails() {
      console.log('查看计划详情');
      this.navigateTo('/frontend/calendar');
    },
    generatePlan() {
      console.log('AI生成计划');
      this.navigateTo('/frontend/ai-assistant');
    },
    createManualPlan() {
      console.log('手动创建计划');
      this.navigateTo('/frontend/manual-plan-creator');
    },
    viewStatistics() {
      console.log('查看数据统计');
      this.navigateTo('/frontend/statistics');
    },
    startAIChat() {
      console.log('开始AI对话');
      this.navigateTo('/frontend/ai-assistant');
    },
    navigateTo(path) {
      if (typeof uni !== 'undefined' && uni.navigateTo) {
        // uni-app鐜
        uni.navigateTo({
          url: path,
          success: () => {
            console.log(`鎴愬姛路宠浆分?${path}`);
          },
          fail: (err) => {
            console.error(`路宠浆澶辫触: ${path}`, err);
            // 灏濊瘯跨敤redirectTo
            uni.redirectTo({
              url: path,
              fail: (err2) => {
                console.error(`澶囩敤鏂规熷け璐? ${path}`, err2);
                // 灏濊瘯娣诲姞.html鍚庣紑 (web鐜)
                this.tryWebPath(path);
              }
            });
          }
        });
      } else {
        // 鐩存帴灏濊瘯Web路緞
        this.tryWebPath(path);
      }
    },
    tryWebPath(path) {
      if (typeof window !== 'undefined') {
        // 灏濊瘯中嶅悓鐨刉eb路緞核煎紡
        const webPaths = [
          path,
          path + '.html',
          path.replace('/frontend/', '/'),
          path.replace('/frontend/', '/') + '.html'
        ];
        
        // 分建iframe娴嬭瘯绗竴中湁数矾寰?
        const testFirstValidPath = (paths, index = 0) => {
          if (index < paths.length) {
            const testPath = paths[index];
            const iframe = document.createElement('iframe');
            iframe.style.display = 'none';
            iframe.onload = () => {
              console.log(`手惧埌近夋晥路緞: ${testPath}`);
              window.location.href = testPath;
              document.body.removeChild(iframe);
            };
            iframe.onerror = () => {
              console.log(`路緞中嶅瓨鍦? ${testPath}`);
              document.body.removeChild(iframe);
              testFirstValidPath(paths, index + 1);
            };
            
            // 记剧疆瓒呮
            setTimeout(() => {
              document.body.removeChild(iframe);
              testFirstValidPath(paths, index + 1);
            }, 2000);
            
            document.body.appendChild(iframe);
            iframe.src = testPath;
          } else {
            // 濡傛灉手近夎矾寰勯兘澶辫触锛屾樉绀烘彁绀?
            console.error('手近夎矾寰勯兘犳硶记块棶');
            if (typeof uni !== 'undefined' && uni.showToast) {
              uni.showToast({
                title: '页面尚未开发',
                icon: 'none'
              });
            } else {
              alert('页面尚未开发');
            }
          }
        };
        
        testFirstValidPath(webPaths);
      }
    }
  }
};
</script>

