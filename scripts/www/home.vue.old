<template>
  <view class="home-container">
    <!-- 顶部导航栏 -->
    <view class="home-header">
      <view class="header-left">
        <view class="user-info">
          <view class="avatar">馃懁</view>
          <view class="user-details">
            <h3 class="username">{{ greeting }}，健身达人</h3>
            <text class="user-stats">今日已完成 {{ completedToday }} 项训练</text>
          </view>
        </view>
      </view>
      <view class="header-right">
        <button class="notification-btn" hover-class="btn-hover">馃敂</button>
      </view>
    </view>

    <!-- AI推荐计划卡片 -->
    <view class="ai-plan-card">
      <view class="card-header">
        <h2 class="section-title">AI今日推荐计划</h2>
        <view class="more-link" @click.prevent="goToCalendar">更多</view>
      </view>
      <view class="plan-content">
        <view class="plan-info">
          <view class="plan-title">全力量记练计划</view>
          <view class="plan-meta">
            <text class="meta-item">鈴憋笍 45分钟</text>
            <text class="meta-item">馃挭 中等强度</text>
            <text class="meta-item">馃敟 消耗约350千卡</text>
          </view>
          <view class="exercise-preview">
            <text class="preview-title">训练动作预览：</text>
            <view class="exercise-list">
              <view class="exercise-item">深蹲 × 3组 × 15次</view>
              <view class="exercise-item">卧推 × 3组 × 12次</view>
              <view class="exercise-item">平支撑 × 3组 × 45秒</view>
              <view class="exercise-item more-exercises">还有4个动作...</view>
            </view>
          </view>
        </view>
        <view class="plan-actions">
          <button class="action-btn primary" @click="startTraining">开始训练</button>
          <button class="action-btn secondary" @click="viewPlanDetails">查看详情</button>
        </view>
      </view>
    </view>

    <!-- 快捷全口区域 -->
    <view class="quick-actions">
      <h2 class="section-title">快捷全口</h2>
      <view class="actions-grid">
        <button class="action-card" @click="generatePlan">
          <view class="action-icon bg-purple">馃</view>
          <view class="action-text">AI生成计划</view>
        </button>
        <button class="action-card" @click="createManualPlan">
          <view class="action-icon bg-blue">馃搵</view>
          <view class="action-text">手动创建计划</view>
        </button>
        <button class="action-card" @click="goToCalendar">
          <view class="action-icon bg-green">馃搮</view>
          <view class="action-text">记练历</view>
        </button>
        <button class="action-card" @click="viewStatistics">
          <view class="action-icon bg-orange">馃搳</view>
          <view class="action-text">数据统计</view>
        </button>
      </view>
    </view>

    <!-- 今日数据统计 -->
    <view class="daily-stats">
      <h2 class="section-title">今日数据</h2>
      <view class="stats-grid">
        <view class="stat-card">
          <view class="stat-value">0 / 3</view>
          <view class="stat-label">记练完成度</view>
          <view class="progress-bar">
            <view class="progress-fill" :style="{ width: '0%' }"></view>
          </view>
        </view>
        <view class="stat-card">
          <view class="stat-value">0 min</view>
          <view class="stat-label">记练堕暱</view>
        </view>
